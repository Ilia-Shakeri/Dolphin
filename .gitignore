# The deployment console's local record of every customer (slug, host,
# features) — scripts/deployment_records.py. Non-secret bookkeeping, but
# customer names/hosts must never enter shared source (CLAUDE.md).
scripts/.dolphin-console/
*.pem
*.key
*.p12
*.pfx
# A signed deployment manifest is one customer's runtime artifact (see
# scripts/sign_deployment_manifest.py), not source. It belongs at
# secrets/manifest.json on the customer host, which secrets/ above already
# excludes; this catches the same file signed at the repo root by habit
# before being copied into place, which is not otherwise excluded.
/manifest.json
dist/
build/
.cache/
node_modules/
.idea/
.vscode/
.DS_Store
Thumbs.db

# A separate git checkout that lives here but is not part of this project.
codex-plugin-cc-probe/

# Which base-image digest has been reviewed is a property of the build machine
# and the date, not of the source. scripts/build-image.sh reads it from here.
.python-base-image
