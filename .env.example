# Deployment identifiers.
#
# The KARIZ_ prefix is a compatibility contract, not branding: compose.yml,
# nginx's envsubst filter, config/production_env.py and the running staging
# deployment all read these exact names. Renaming them would break an existing
# .env on upgrade for no functional gain, so they are retained deliberately.
# Everything a customer sees says FrooshBin / فروش‌بین.
KARIZ_COMPOSE_PROJECT_NAME=replace-with-approved-stable-lowercase-project-name
KARIZ_APP_IMAGE=replace-with-reviewed-app-repository@sha256:replace-with-reviewed-64-hex-digest
KARIZ_POSTGRES_IMAGE=replace-with-reviewed-postgres-repository@sha256:replace-with-reviewed-64-hex-digest
KARIZ_NGINX_IMAGE=replace-with-reviewed-nginx-repository@sha256:replace-with-reviewed-64-hex-digest
PYTHON_BASE_IMAGE=replace-with-reviewed-python-repository@sha256:replace-with-reviewed-64-hex-digest
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
# Public identity. With a domain, these three hold the domain. With no domain,
# the customer's static public IP goes in all three instead — for example
# DJANGO_ALLOWED_HOSTS=203.0.113.10, DJANGO_CSRF_TRUSTED_ORIGINS=https://203.0.113.10,
# KARIZ_PUBLIC_HOST=203.0.113.10. See docs/ops/CLIENT1_LINUX_STAGING_GUIDE.md
# for what an IP-only deployment costs.
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
KARIZ_PUBLIC_HOST=crm.example.com
# Networks whose X-Real-IP header the application may believe. In the standard
# single-host stack the only proxy is the bundled nginx, which reaches the
# application over Compose's own bridge network — so this must name that
# network, or every audit row records nginx's container address instead of the
# address the user actually came from, and the audit trail identifies nobody.
#
# Find the real value once, after `docker compose up -d`:
#   docker network inspect <project>_frontend --format '{{(index .IPAM.Config 0).Subnet}}'
# Leave it empty only where nothing proxies the application.
AUDIT_TRUSTED_PROXY_CIDRS=172.16.0.0/12
DJANGO_SECURE_SSL_REDIRECT=true
# HSTS is one year (or more) or exactly 0. Nothing weaker is accepted, because a
# short pin looks like protection without being any. Use 0 ONLY for a staging or
# IP-only deployment with a self-signed certificate, and set KARIZ_HSTS_HEADER
# empty to match; a real certificate on a real domain keeps the default.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
KARIZ_HSTS_HEADER=max-age=31536000
KARIZ_TLS_CERT_PATH=replace-with-approved-certificate-chain-path
KARIZ_TLS_KEY_PATH=replace-with-approved-private-key-path
# Database identity. These are the names a FRESH install creates. An existing
# staging deployment keeps whatever its own .env already says — the application
# reads every one of them from the environment and hardcodes none, so renaming
# here changes new installs only and never touches a running one.
POSTGRES_DB=frooshbin
POSTGRES_INIT_USER=frooshbin_init
POSTGRES_INIT_PASSWORD=replace-with-a-long-random-init-password
POSTGRES_MIGRATION_USER=frooshbin_migration
POSTGRES_MIGRATION_PASSWORD=replace-with-a-long-random-migration-password
POSTGRES_APP_USER=frooshbin_app
POSTGRES_APP_PASSWORD=replace-with-a-long-random-app-password
POSTGRES_BACKUP_USER=frooshbin_backup
POSTGRES_BACKUP_PASSWORD=replace-with-a-long-random-backup-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=3
POSTGRES_DATA_VOLUME=frooshbin_postgres_data
POSTGRES_BACKUP_VOLUME=frooshbin_postgres_backups
POSTGRES_BACKUP_RETENTION_DAYS=0
POSTGRES_RESTORE_TMPFS_SIZE_BYTES=1073741824
# Deployment profile (PROFILE-001, Option C). The manifest is issued and signed
# by the platform owner with scripts/sign_deployment_manifest.py and mounted
# read-only. Only the public verification key is configured here; the private
# signing key never reaches a customer host.
KARIZ_DEPLOYMENT_MANIFEST_PATH=replace-with-the-approved-signed-manifest-path
KARIZ_DEPLOYMENT_MANIFEST_KEYS=replace-with-key-id:replace-with-base64-ed25519-public-key
# Server-generated PDF (optional). Empty leaves the feature off, and users still
# get correct PDFs through their browser's print / save-as-PDF. Setting
# "chromium" requires a Chromium binary inside the application image; see
# docs/ops/MULTI_SERVER_DOCKER_DEPLOYMENT.md section 3 for the trade-off.
KARIZ_PDF_RENDERER=
KARIZ_PDF_CHROMIUM_BINARY=
KARIZ_PDF_RENDER_TIMEOUT_SECONDS=20
# Transport security to PostgreSQL. Empty is correct for a single-host
# deployment, where the database is only reachable on an internal Docker
# network. A split app/database deployment must set verify-full and provide the
# CA bundle, or credentials and rows cross the network in the clear.
POSTGRES_SSLMODE=
POSTGRES_SSLROOTCERT=
